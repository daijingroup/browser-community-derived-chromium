#
# Kiryra: brave_component_updater and brave_extensions deps replaced with
# the Chromium equivalents that the rule parser actually needs.
# debounce_component_installer and debounce_service are not integrated here;
# Kiryra supplies its own wiring via chrome/browser/debounce/.

source_set("browser") {
  sources = [
    "debounce_rule.cc",
    "debounce_rule.h",
  ]

  deps = [
    "//base",
    "//components/debounce/core/common",
    "//components/prefs",
    "//extensions/common",
    "//net",
    "//third_party/re2",
    "//url",
  ]
}
